{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "zrc module registry",
  "type": "object",
  "required": [
    "schema",
    "version",
    "palette",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zrc.registry.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "palette": {
      "const": "ink"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "binaries",
          "mappings"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string"
          },
          "binaries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activation": {
            "type": "string"
          },
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source",
                "destination"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "destination": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
