# Include this file explicitly; it does not set identity, signing or transport.
[color]
    ui = auto
[color "branch"]
    current = "#d4a373" bold
    local = "#e8ded2"
    remote = "#a3978b"
[color "diff"]
    old = "#e59a91"
    new = "#d4a373"
    meta = "#a3978b"
    frag = "#c5a4b6"
[color "status"]
    added = "#d4a373"
    changed = "#e59a91"
    untracked = "#a3978b"
